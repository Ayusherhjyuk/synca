# ─────────────────────────────────────────────────────────────
# Collaborative Document Editor — Environment Variables
# Copy this file to `.env.local` and fill in the values.
# ─────────────────────────────────────────────────────────────

# MongoDB connection string (Atlas or local).
# Local example: mongodb://127.0.0.1:27017/collab-editor
MONGODB_URI="mongodb://127.0.0.1:27017/collab-editor"

# Auth.js (NextAuth v5) secret — used to sign session JWTs AND the
# short-lived realtime tokens the WebSocket server verifies.
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Trust the host header (required for Auth.js v5 behind proxies/Vercel).
AUTH_TRUST_HOST="true"

# Public URL of the standalone WebSocket sync server.
# Local: ws://localhost:1234   Prod: wss://your-ws-host.up.railway.app
NEXT_PUBLIC_WS_URL="ws://localhost:1234"

# Port the standalone WebSocket server listens on.
WS_PORT="1234"

# Groq API key for the AI add-on features (summarize / improve / continue).
# Free key from https://console.groq.com/keys . Optional — AI routes degrade
# gracefully if missing.
GROQ_API_KEY=""

# Max accepted sync payload size in bytes (anti-OOM guard). Default 1 MB.
MAX_SYNC_PAYLOAD_BYTES="1048576"
